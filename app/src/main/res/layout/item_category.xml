<?xml version="1.0" encoding="utf-8"?>
<!-- item_category.xml — single category row in the categories list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <!-- Category name -->
    <TextView
        android:id="@+id/tv_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Food"
        android:textSize="14sp"
        android:textColor="@color/text_primary" />

    <!-- Edit icon -->
    <ImageView
        android:id="@+id/iv_edit_category"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit category"
        android:layout_marginEnd="12dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- Delete icon -->
    <ImageView
        android:id="@+id/iv_delete_category"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_delete"
        android:contentDescription="Delete category"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
