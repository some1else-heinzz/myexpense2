<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <View
        android:id="@+id/v_choice_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_icon_circle_green" />

    <ImageView
        android:id="@+id/iv_choice_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_food"
        app:tint="@color/green_primary"
        android:contentDescription="Icon Choice" />

    <View
        android:id="@+id/v_selection_indicator"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_selection_border"
        android:visibility="gone" />

</FrameLayout>