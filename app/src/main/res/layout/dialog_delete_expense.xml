<?xml version="1.0" encoding="utf-8"?>
<!-- dialog_delete_expense.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/bg_dialog">

    <!-- Trash icon -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_delete_circle"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete"
            android:tint="#D32F2F" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/delete_expense"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <!-- Confirmation message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation = "horizontal"
        android:text="@string/delete_confirm"
        android:textSize="13sp"
        android:textColor="#757575"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="24dp" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Cancel -->
        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:textColor="#212121"
            android:backgroundTint="@color/divider"
            android:layout_marginEnd="8dp" />

        <!-- Delete -->
        <Button
            android:id="@+id/btn_delete_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/delete"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/red_delete"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
